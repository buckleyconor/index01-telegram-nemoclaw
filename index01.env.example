# Copy to /etc/index01.env, fill in, then: chmod 600 && chown root:root
# S8: never commit the real file.

# Shared secret with the Pebble app webhook header.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INDEX01_SECRET=

# Full credential for the bot (S8).
# NOTE: this must be a bot that nothing else long-polls. @existing_bot is
# already polled by the-king's OpenClaw telegram channel; sharing it makes
# approval taps disappear at random. See SPEC Q5.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

TRIGGER_PHRASE=hey nemo
NEMOCLAW_TIMEOUT=300
APPROVAL_TTL=900
DB_PATH=/var/lib/index01/jobs.db

# Step 2 only. Step 5 sets this to false and removes the RAW PAYLOAD line.
LOG_TRANSCRIPTS=true

# Send every turn through the approval gate, including ones the classifier would
# pass as read-only. Keep this true while NEMOCLAW_AGENT_RO is an agent that can
# still mutate -- otherwise a mis-heard question that happens to match the
# read-only regex runs with full tool access. Flip to false only after creating a
# genuinely restricted read-only agent.
REQUIRE_APPROVAL_ALL=true

# NemoClaw wiring (Step 4).
NEMOCLAW_SANDBOX=the-king
# argv prefix as a JSON list. The relay runs as democenter, so it can exec the
# binary directly -- no sudo wrapper needed. See SPEC Q6 for why the dedicated-user
# and HTTP-gateway alternatives were both rejected.
NEMOCLAW_CMD=["/home/democenter/.local/bin/nemoclaw"]
# Separate agent ids let S6 (narrowest viable toolset) be enforced per class.
# Both are `main` until a restricted read-only agent exists, which is why
# REQUIRE_APPROVAL_ALL is on.
NEMOCLAW_AGENT_RO=main
NEMOCLAW_AGENT_RW=main
